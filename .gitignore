# ───────────────────────── Сборка и зависимости ─────────────────────────
# Генерируется командами npm run build / build:electron — в репозиторий не нужно
dist/
dist-electron/
release/
out/
node_modules/
*.tsbuildinfo
coverage/

# ───────────────────────── Логи ─────────────────────────
*.log
npm-debug.log*

# ───────────────────────── Данные пользователя (НЕ ПУБЛИКОВАТЬ) ─────────────────────────
# Приложение хранит данные в папке userData (на Windows это %APPDATA%\NEKO, %APPDATA%\ARIA или
# %APPDATA%\neko-aria-suite), а не в папке проекта. Но если такая папка или её копия окажется рядом с кодом —
# в ней история переписки, дневник, фото и API-ключи в открытом виде.
# Папки с данными привязаны к корню (с «/» в начале): иначе «diary/» скрыл бы и исходники src/neko/components/diary/
/userData/
/memory/
/diary/
*.jsonl
reminders.json
app-prefs.json
window-state*.json
settings*.json

# ───────────────────────── Секреты ─────────────────────────
.env
.env.*
!.env.example
*.key
*.pem

# ───────────────────────── 3D-модели и анимации ─────────────────────────
# VRM-модели обычно нельзя распространять (лицензия автора модели). Каждый кладёт свою — см. public/models/README.md
*.vrm
*.vrma
public/models/*.vrm
# в public/animations оставляем только README
public/animations/*
!public/animations/README.md

# ───────────────────────── Редакторы и ОС ─────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ───────────────────────── Архивы обновлений ─────────────────────────
/*.zip
/UPDATE_*.md
